{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "FileStorage": {
    "MaxFileSizeInMB": 5
  },
  "TeamInvite": {
    "ResendCooldownDays": 3,
    "ExpirationDays": 14,
    "RetentionDays": 90,
    "DeclinedResendLimit": 3,
    "MaintenanceBatchSize": 100,
    "MaintenanceIntervalSeconds": 60,
    "MaintenanceEventConcurrency": 4
  },
  "RateLimiting": {
    "GlobalPermitLimit": 120,
    "SearchPermitLimit": 30,
    "WindowSeconds": 60
  },
  "Auth0": {
    "Authority": "https://mercurius-aalst.eu.auth0.com/",
    "RoleClaimType": "https://mercurius-aalst.be/roles",
    "ManagementAudience": "https://mercurius-aalst.eu.auth0.com/api/v2/",
    "DatabaseConnection": "Username-Password-Authentication"
  }
}
